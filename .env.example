# Copy the names you need into .env (never commit real values).

# Discord webhook for the app's alerts.
DISCORD_WEBHOOK_URL=
# Optional: a separate Discord channel for the News brief. Falls back to DISCORD_WEBHOOK_URL.
NEWS_DISCORD_WEBHOOK_URL=

# News brief: OpenRouter key. Rates headlines and writes the mood. The model is chosen on the News page.
OPENROUTER_API_KEY=
# Set to "off" to keep the news bot's clock from starting (the News page still works by hand).
# NEWS_BOT=off

# Prices for the backtester.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
DATABENTO_API_KEY=
